{
  "name": "json-scripts",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "permits": "tsx permit/scrape_permit.ts",
    "pendle": "tsx pendle/pendle.ts",
    "spectra": "tsx spectra/spectra.ts",
    "rwa": "tsx rwa/rwa.ts",
    "rwa:check": "tsx rwa/checkEquity.ts",
    "test": "tsx --test labels/*.test.ts pendle/*.test.ts",
    "lst": "tsx lst/lst.ts",
    "risk": "tsx risk/risk.ts",
    "stablecoin": "tsx stablecoin/stablecoin.ts",
    "savings": "tsx savings/savings.ts",
    "oft": "tsx oft/oft.ts",
    "ccip": "tsx ccip/ccip.ts",
    "oft:mesh": "tsx oft/meshReport.ts",
    "oft:mesh:check": "tsx oft/meshReport.ts --check",
    "issuer": "tsx issuer/issuer.ts",
    "issuer:check": "tsx issuer/check.ts",
    "issuer:check:eth-btc": "tsx issuer/checkEthBtc.ts",
    "exponent": "tsx exponent/exponent.ts",
    "solana": "npm run exponent && tsx solana/solana.ts",
    "sugar": "tsx onchain-fetch/sugar.ts",
    "onchain": "tsx onchain-fetch/fetch.ts",
    "onchain:decimals": "tsx onchain-fetch/verifyDecimals.ts",
    "logos": "tsx logos/backfillLogos.ts",
    "logos:groups": "tsx logos/groupLogos.ts",
    "logos:groups:check": "tsx logos/groupLogos.ts --check",
    "notes": "tsx notes/notes.ts",
    "notes:check": "tsx notes/notes.ts --check",
    "format": "npx prettier .. -w --object-wrap collapse --ignore-path ../.gitignore --ignore-path .prettierignore",
    "fetch:lists": "tsx fetchLists.script.ts",
    "generate": "tsx generateTokenMap.script.ts",
    "generate:cached": "GEN_CACHE=1 tsx generateTokenMap.script.ts",
    "regen": "GEN_CACHE=1 tsx generateTokenMap.script.ts && npm run format",
    "portal": "tsx portalTokens.script.ts",
    "update:1delta": "bash ./update-1delta-packages.sh",
    "generate:formatted": "tsx pipeline.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@1delta/chain-registry": "^0.0.10",
    "@1delta/data-sdk": "^0.0.67",
    "@1delta/providers": "^0.0.78",
    "@1delta/wnative": "^0.0.14",
    "viem": "^2.48.4"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true
  }
}
